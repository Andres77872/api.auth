# .env.example - documented configuration template
#
# Copy this file to .env for local development and replace every placeholder
# secret before using it outside tests. Do not commit real .env or .env.test
# files.

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# App runtime marker. Use production/staging/development/local/test values.
# JWT fallback secrets are only allowed in explicit test runtimes.
APP_ENV=development

# Environment label stored with DB error logs. Defaults to development.
ENVIRONMENT=development

# Include detailed errors in API responses when true/1/yes. Keep false outside
# local development and tests.
DEBUG_MODE=false

# Comma-separated browser origins allowed by CORS. Set exact production clients.
# This list ALSO gates which origins are accepted in transactional email links:
# a caller (BFF) relays the end-user's origin via the X-Public-Base-Url header and
# the activation/reset link is built from it only when the origin is listed here.
# So every frontend origin that triggers emails must appear below (incl. LAN IPs
# like http://192.168.1.13:5173). Use "*" to accept any forwarded origin (dev only).
# When unset the app falls back to a single built-in list (DEFAULT_ALLOWED_ORIGINS
# in src/Util/auth_constants.py) shared by CORS, the early-reject middleware and
# email-link origin validation. That list holds localhost/LAN origins AND the
# hosted UI origin https://auth-ui.arz.ai, so set this explicitly in every
# deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://localhost:5177

# Public base URL of this API (scheme://host[:port][/prefix]) used for the absolute
# links in GET /llms.txt. Leave blank to use the URL each request was made to. Set it
# when a proxy terminates TLS or rewrites the host, so the links are not http:// or an
# internal host name.
PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# MySQL application database
# ---------------------------------------------------------------------------

# MySQL host used by the application.
DB_HOST=127.0.0.1

# MySQL port. Defaults to 3306 when optional code paths allow defaults.
DB_PORT=3306

# MySQL user used by the application.
DB_USER=auth_app

# MySQL password used by the application. Required by src.Util.db_config.
DB_MYSQL_PASSWORD=change-me-mysql-password

# Application database name.
DB_NAME=magic_auth

# DBUtils PersistentDB max uses per pooled connection before recycle.
DB_POOL_MAXUSAGE=1000

# DBUtils PersistentDB ping mode. 0 disables ping, 1 pings when borrowing.
DB_POOL_PING=1

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis host used for sessions, refresh-token lifecycle state, and caches.
REDIS_HOST=127.0.0.1

# Redis port. Defaults to 6379 when optional code paths allow defaults.
REDIS_PORT=6379

# Redis logical database number.
REDIS_DB=0

# Redis password. Leave blank when Redis has no password.
DB_REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication and API keys
# ---------------------------------------------------------------------------

# JWT signing secret. Required outside explicit test runtime.
# Generate a strong value, for example: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Access-token TTL in minutes. Refresh-token families are not configurable: 72 hours
# (sliding) by default, 30 days (absolute) when the login sends remember_me=true.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Server-side password policy. Minimum length is explicit and configurable;
# weak denylist values are matched without logging or returning candidates.
PASSWORD_POLICY_MIN_LENGTH=8
PASSWORD_POLICY_WEAK_DENYLIST=password,12345678,123456789,1234567890,qwerty,letmein,admin,password1,welcome,iloveyou,monkey,dragon,football,baseball,abc123

# Authenticated change-password rate limits. Uses non-PII Redis keys derived from
# user/session/IP buckets and returns INT_7005 with Retry-After when exceeded.
AUTH_CHANGE_PASSWORD_FAILURE_LIMIT=5
AUTH_CHANGE_PASSWORD_FAILURE_WINDOW_SECONDS=900
AUTH_CHANGE_PASSWORD_USER_HOURLY_LIMIT=5
AUTH_CHANGE_PASSWORD_SESSION_HOURLY_LIMIT=5
AUTH_CHANGE_PASSWORD_IP_HOURLY_LIMIT=20

# Server-side HMAC pepper for API key split-token hashing. Required before
# importing src.Util.api_key_security.
# Generate a strong value, for example: openssl rand -hex 32
API_KEY_PEPPER=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Transactional auth email delivery (email activation / password reset)
# ---------------------------------------------------------------------------

# Public base URL used to build emailed activation/reset links
#   {base}/auth/email/verify?token=...   and   {base}/auth/password/reset?token=...
# LEAVE BLANK for the recommended agnostic behavior: the link origin is taken
# per-request from the X-Public-Base-Url header the caller (BFF) forwards (the
# end-user's browser origin), validated against ALLOWED_ORIGINS. Set this ONLY to
# hard-pin a single origin for a locked single-tenant deployment; when set it
# overrides the forwarded origin. PUBLIC_AUTH_BASE_URL and BASE_URL are fallbacks.
AUTH_EMAIL_PUBLIC_BASE_URL=

# Primary rollback and safety switch. Keep false until schema, redaction,
# rate/idempotency, provider readiness, and worker health have passed.
EMAIL_DELIVERY_ENABLED=false

# Provider selection. Safe local/test defaults are fake or mailpit. Production
# default is resend only after prerequisites pass.
EMAIL_PROVIDER=fake

# Explicit guard for real provider sends in tests. Never set true in normal test
# runs; use only for deliberate provider smoke tests with isolated credentials.
EMAIL_ALLOW_REAL_SEND_IN_TESTS=false

# Sender posture. Use a verified production sender/domain before enabling real
# Resend delivery.
EMAIL_FROM_ADDRESS=Auth <auth@example.com>
# Optional Reply-To for every outgoing email (worker sends and admin send-test),
# so replies reach a monitored inbox while From stays on the verified sender
# domain. One mailbox, bare (support@example.com) or named
# (Support <support@example.com>); it does not need to be on the sender domain.
# Leave blank to send without a Reply-To. A malformed value makes email
# readiness report not_ready with this key in missing[]. Read at process start:
# restart the API and email worker after changing it.
EMAIL_REPLY_TO_ADDRESS=
EMAIL_SENDER_DOMAIN_VERIFIED=false

# Resend provider configuration. Leave credentials blank in local/test unless an
# explicit real-send smoke test is being run.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Parsed but not consumed yet: webhook verification is delegated to Svix, which
# enforces its own fixed 5-minute timestamp tolerance, so this has no effect.
RESEND_WEBHOOK_TOLERANCE_SECONDS=300

# Mailpit/local capture configuration used by e2e tests and local safe delivery.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
# Parsed by the app but used by the e2e tests only.
MAILPIT_API_BASE_URL=http://127.0.0.1:8025

# Email token/hash/encryption material. Generate strong unique values outside
# tests. EMAIL_PAYLOAD_KEY must be a URL-safe base64 Fernet-compatible key; the
# placeholder below is rejected with EmailConfigError at the first email-config
# load. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_TOKEN_PEPPER=change-me-email-token-pepper
EMAIL_HASH_PEPPER=change-me-email-hash-pepper
EMAIL_IDEMPOTENCY_PEPPER=change-me-email-idempotency-pepper
EMAIL_PAYLOAD_KEY=change-me-fernet-key-generate-with-python-cryptography

# Link and retention defaults.
EMAIL_ACTIVATION_TOKEN_TTL_SECONDS=86400
EMAIL_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_IDEMPOTENCY_TTL_SECONDS=86400
EMAIL_TERMINAL_RETENTION_DAYS=30
# Parsed but not consumed yet: setting it currently has no effect.
EMAIL_DELIVERY_ATTEMPT_RETENTION_DAYS=365

# Rate limits frozen by the email-activation SDD spec.
EMAIL_SEND_RECIPIENT_HOURLY_LIMIT=3
EMAIL_SEND_RECIPIENT_DAILY_LIMIT=10
EMAIL_SEND_USER_HOURLY_LIMIT=5
EMAIL_SEND_IP_HOURLY_LIMIT=20
EMAIL_CONSUME_LOOKUP_HOURLY_LIMIT=5
EMAIL_CONSUME_IP_HOURLY_LIMIT=30
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_LOGIN_IDENTIFIER_FAILURE_LIMIT=10
EMAIL_LOGIN_IDENTIFIER_FAILURE_WINDOW_SECONDS=900
# Companion per-account login-failure bucket. Both buckets are enforced together
# by src.Util.email.rate_limit.EmailRateLimiter on the login failure paths.
EMAIL_LOGIN_ACCOUNT_FAILURE_LIMIT=30
EMAIL_LOGIN_ACCOUNT_FAILURE_WINDOW_SECONDS=900

# Worker defaults. The worker can be stopped independently; durable outbox rows
# remain inspectable and are never replaced by Redis as the delivery ledger.
EMAIL_WORKER_POLL_SECONDS=5
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_WORKER_LEASE_SECONDS=300
EMAIL_WORKER_MAX_ATTEMPTS=8
EMAIL_WORKER_BACKOFF_SECONDS=10,30,120,600,1800,3600,7200,14400

# Cadence at which the long-running worker invokes sp_email_retention_purge to
# redact transient render payloads and plaintext recipient PII, delete expired
# link tokens, strip old delivery-attempt metadata, and expire idempotency keys.
# 0 disables in-worker purging (run scripts/recreate or a cron instead).
EMAIL_RETENTION_PURGE_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Cache and decorator behavior
# ---------------------------------------------------------------------------

# Enable full-session validate-session cache.
VALIDATE_CACHE_ENABLED=true

# Full-session validation cache TTL, in seconds.
VALIDATE_CACHE_TTL=30

# Let decorators reuse request.state session validation when available.
REQUEST_STATE_PASSTHROUGH=true

# Use FastAPI BackgroundTasks for activity logging when available.
ASYNC_ACTIVITY_LOGGING=true

# ---------------------------------------------------------------------------
# External access logger
# ---------------------------------------------------------------------------

# Optional token header values for src.Util.logger_ws, which sends request
# telemetry to https://log.arz.ai when request validation logging is not patched.
# Leave blank to avoid sending credentials.
LOG_TOKEN_USER=
LOG_TOKEN_REALM=

# ---------------------------------------------------------------------------
# Real infrastructure and e2e tests
# ---------------------------------------------------------------------------

# Real MySQL host for real_db/e2e tests. docker-compose.test.yml overrides this
# to mysql-test inside the e2e container.
REAL_DB_HOST=127.0.0.1

# Real MySQL port for real_db/e2e tests. Local test compose exposes 3307.
REAL_DB_PORT=3307

# Real MySQL user for real_db/e2e tests.
REAL_DB_USER=test_user

# Real MySQL password for real_db/e2e tests.
REAL_DB_PASSWORD=test_mysql_password

# Real MySQL database for real_db/e2e tests.
REAL_DB_NAME=magic_auth

# Real Redis host for real_db/e2e tests.
REAL_REDIS_HOST=127.0.0.1

# Real Redis port for real_db/e2e tests. Local test compose exposes 6380.
REAL_REDIS_PORT=6380

# Seconds scripts/wait-for-e2e-services.py waits for MySQL and Redis readiness.
E2E_SERVICE_WAIT_SECONDS=120

# Optional docker group name used by scripts/run-e2e.sh when it needs to re-run
# under the Docker socket group.
E2E_DOCKER_GROUP=

# Internal guard set by scripts/run-e2e.sh during Docker group re-exec.
# Do not set manually.
# E2E_DOCKER_GROUP_REEXEC=

# Pytest sets this while a test is running. It switches the configuration loaders
# into explicit test runtime (for example the JWT fallback secret). The OAuth
# sign-in routes have no test-only code paths. Never set it in a deployed
# environment. Do not set manually.
# PYTEST_CURRENT_TEST=

# ---------------------------------------------------------------------------
# Deprecated or legacy names
# ---------------------------------------------------------------------------

# Deprecated fallback for old shells, still accepted by src.Util.db_config
# (_require_env("DB_MYSQL_PASSWORD")) and by
# scripts/create_database.py, scripts/recreate_database.py, scripts/schema_sync.py
# and scripts/migrations/*.py. Prefer DB_MYSQL_PASSWORD everywhere.

# --- OAuth deployment configuration ---
# Provider credentials and project bindings are managed through /admin/oauth.
OAUTH_ENABLED=false
OAUTH_STATE_PEPPER=<oauth-state-pepper>
OAUTH_PROVIDER_SUB_PEPPER=<oauth-provider-sub-pepper>
OAUTH_EMAIL_HASH_PEPPER=<oauth-email-hash-pepper>
OAUTH_SECRET_ENCRYPTION_KEY=<fernet-key>
OAUTH_SECRET_ENCRYPTION_KEY_ID=oauth-v1
OAUTH_SECRET_DECRYPTION_KEYS_JSON={}
OAUTH_SECRET_HMAC_KEY=<oauth-secret-hmac-key>
OAUTH_MAX_STATE_TTL_SECONDS=600
OAUTH_RECENT_REAUTH_SECONDS=300
OAUTH_JWKS_CACHE_TTL_SECONDS=3600
OAUTH_LEEWAY_SECONDS=30
OAUTH_FAIL_CLOSED_ON_REDIS_ERROR=true
OAUTH_TRUSTED_PROXY_CIDRS=
OAUTH_ALLOW_PRIVATE_IDP_HOSTS=false
OAUTH_START_RATE_LIMIT=20
OAUTH_START_RATE_WINDOW_SECONDS=60
OAUTH_CALLBACK_RATE_LIMIT=30
OAUTH_CALLBACK_RATE_WINDOW_SECONDS=60
OAUTH_STATE_CONSUME_RATE_LIMIT=60
OAUTH_STATE_CONSUME_RATE_WINDOW_SECONDS=60
OAUTH_SUB_COLLISION_RATE_LIMIT=10
OAUTH_SUB_COLLISION_RATE_WINDOW_SECONDS=300
OAUTH_UNLINK_RATE_LIMIT=10
OAUTH_UNLINK_RATE_WINDOW_SECONDS=300
# Inputs for scripts/provision_google_oauth.py; runtime requests use the database.
SETUP_GOOGLE_OAUTH_CLIENT_ID=
SETUP_GOOGLE_OAUTH_CLIENT_SECRET=
SETUP_GOOGLE_OAUTH_SCOPES=openid email
SETUP_GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:8000/auth/oauth/callback
SETUP_GOOGLE_OAUTH_RETURN_ORIGINS=http://localhost:3000
SETUP_GOOGLE_OAUTH_PROVISIONING_MODE=disabled
SETUP_GOOGLE_OAUTH_ALLOWED_HOSTED_DOMAINS=
# scripts/create_database.py prompts when this value is empty.
BOOTSTRAP_ROOT_PASSWORD=
# --- End OAuth ---

# --- Patreon account link / entitlement propagation (NOT login) ---
# Disabled by default. Patreon is an entitlement/link source only; it must never
# issue local sessions, JWTs, refresh tokens, cookies, API keys, or mutate
# /auth/validate. Enable each switch only after schema, redaction, tier-map,
# webhook, S2S, sync, retention, and runbook checks pass.
PATREON_LINKING_ENABLED=false
PATREON_WEBHOOKS_ENABLED=false
PATREON_SYNC_ENABLED=false
PATREON_S2S_ENTITLEMENT_ENABLED=false
PATREON_CREATOR_TOKEN_REFRESH_ENABLED=false
PATREON_RAW_PAYLOAD_CAPTURE_ENABLED=false

# Creator-owned Patreon API configuration. These values are server-only.
# Never store per-user Patreon tokens; never expose these values to browser
# responses, audit details, activity details, metrics, or logs.
PATREON_API_BASE_URL=https://www.patreon.com/api/oauth2/v2
PATREON_OAUTH_TOKEN_URL=https://www.patreon.com/api/oauth2/token
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_WEBHOOK_SECRET=
# Parsed but not consumed yet: setting it currently has no effect.
PATREON_WEBHOOK_ID=
PATREON_S2S_BEARER_TOKEN=
PATREON_USER_AGENT=api.auth-patreon-sync/1.0

# Server-only HMAC/crypto material. Generate unique high-entropy values outside
# tests; rotate through the runbook, not through source control.
PATREON_PROVIDER_SUB_PEPPER=
PATREON_EMAIL_HASH_PEPPER=
PATREON_PROOF_TOKEN_PEPPER=
PATREON_ID_HMAC_SECRET=
# Legacy fallback alias of PATREON_ID_HMAC_SECRET, read only when that one is
# empty. Leave blank and set PATREON_ID_HMAC_SECRET instead.
PATREON_WEBHOOK_DELIVERY_HASH_PEPPER=
# Required when PATREON_CREATOR_TOKEN_REFRESH_ENABLED=true or
# PATREON_RAW_PAYLOAD_CAPTURE_ENABLED=true. Used only for encrypted global
# creator-token state / encrypted raw-payload quarantine; never per-user tokens.
PATREON_PROVIDER_TOKEN_ENCRYPTION_KEY=
PATREON_PROVIDER_TOKEN_ENCRYPTION_KEY_ID=

# Multi-campaign tier-map configuration. Raw Patreon campaign/tier IDs stay
# server-only. Prefer PATREON_CAMPAIGN_TIER_MAP or PATREON_TIER_MAP_FILE for
# structured config. PATREON_CAMPAIGN_IDS only ADDS campaigns to the ones named in the tier map
# (the worker syncs the union); it is not an allow-list and does not filter anything.
PATREON_CAMPAIGN_IDS=
PATREON_CAMPAIGN_TIER_MAP=
PATREON_TIER_MAP_JSON=
PATREON_TIER_MAP_FILE=
PATREON_ALLOWED_WEBHOOK_EVENTS=members:create,members:update,members:delete,members:pledge:create,members:pledge:update,members:pledge:delete

# Retention windows from the Patreon SDD. Do not loosen these caps without a new
# spec: proof rows purge/strip 24h after expiry, webhook delivery hashes 90d,
# raw payload quarantine 30d max, and link/snapshot/unlink history is indefinite.
PATREON_PROOF_TOKEN_TTL_SECONDS=900
PATREON_PROOF_RETENTION_AFTER_EXPIRY_HOURS=24
PATREON_WEBHOOK_DELIVERY_RETENTION_DAYS=90
PATREON_RAW_PAYLOAD_RETENTION_DAYS=30

# Provider API, sync, staleness, alert, and worker defaults.
PATREON_API_TIMEOUT_SECONDS=15
PATREON_API_CONNECT_TIMEOUT_SECONDS=5
PATREON_API_PAGE_SIZE=1000
PATREON_API_MAX_PAGES_PER_SYNC=0
# Parsed but not consumed yet: setting it currently has no effect.
PATREON_API_RETRY_MAX_ATTEMPTS=3
PATREON_API_RETRY_BACKOFF_SECONDS=1,5,15
PATREON_API_RETRY_JITTER_SECONDS=5
# Parsed but not consumed yet: setting it currently has no effect.
PATREON_CREATOR_TOKEN_REFRESH_MARGIN_SECONDS=604800
PATREON_SYNC_INTERVAL_SECONDS=21600
PATREON_SYNC_JITTER_SECONDS=900
PATREON_SYNC_STALE_AFTER_SECONDS=86400
PATREON_SYNC_WORKER_POLL_SECONDS=30
PATREON_SYNC_WORKER_BATCH_SIZE=25
PATREON_SYNC_JOB_LEASE_SECONDS=300
PATREON_SYNC_MAX_ATTEMPTS=8
PATREON_SYNC_BACKOFF_SECONDS=60,300,900,3600,10800,21600
PATREON_WEBHOOK_SIGNATURE_FAILURE_ALERT_LIMIT=1
PATREON_WEBHOOK_SIGNATURE_FAILURE_ALERT_WINDOW_SECONDS=60

# Patreon abuse/provider rate limits. Redis keys must use hashed bucket material
# only; never raw IPs, user hashes, emails, campaign IDs, tier IDs, or tokens.
PATREON_LINK_REQUEST_RATE_LIMIT=5
PATREON_LINK_REQUEST_RATE_WINDOW_SECONDS=3600
PATREON_PROOF_REQUEST_RATE_LIMIT=3
PATREON_PROOF_REQUEST_RATE_WINDOW_SECONDS=3600
PATREON_PROOF_CONSUME_RATE_LIMIT=5
PATREON_PROOF_CONSUME_RATE_WINDOW_SECONDS=900
PATREON_UNLINK_RATE_LIMIT=5
PATREON_UNLINK_RATE_WINDOW_SECONDS=300
PATREON_STATUS_RATE_LIMIT=60
PATREON_STATUS_RATE_WINDOW_SECONDS=60
PATREON_S2S_RATE_LIMIT=120
PATREON_S2S_RATE_WINDOW_SECONDS=60
PATREON_WEBHOOK_SIGNATURE_FAILURE_RATE_LIMIT=30
PATREON_WEBHOOK_SIGNATURE_FAILURE_RATE_WINDOW_SECONDS=60
PATREON_SYNC_ENQUEUE_RATE_LIMIT=30
PATREON_SYNC_ENQUEUE_RATE_WINDOW_SECONDS=300
PATREON_API_CLIENT_RATE_LIMIT=100
PATREON_API_CLIENT_RATE_WINDOW_SECONDS=2
PATREON_API_ACCESS_TOKEN_RATE_LIMIT=100
PATREON_API_ACCESS_TOKEN_RATE_WINDOW_SECONDS=60
PATREON_API_EDGE_4XX_RATE_LIMIT=2000
PATREON_API_EDGE_4XX_RATE_WINDOW_SECONDS=600

# Optional tests. Live Patreon smoke is opt-in only and must use isolated test
# creator/member credentials supplied by operators, never committed here.
RUN_PATREON_LOCAL_E2E=false
RUN_PATREON_E2E=false
PATREON_LIVE_TEST_USER_HASH=
PATREON_TEST_CAMPAIGN_ID=
PATREON_TEST_MEMBER_EMAIL=
# --- End Patreon account link / entitlement propagation ---

# --- Provider-agnostic billing with Stripe (NOT login/auth/session) ---
# Disabled by default. Billing is server-to-server only and must never add raw
# provider/Checkout/Portal/refund/dispute fields to JWTs, cookies, sessions, or
# login DTOs. (The one intentional exception: /auth/validate, login, and
# validate-api-key carry a neutral subscription `plan` object — state none|free|
# trial|active|past_due|canceled + plan_code/tier_code/expiry — resolved through
# the session project's billing group. Subscriptions only; packages/credits stay
# consumer-owned.)
#
# Billing unit = BILLING GROUP: one group owns one Stripe account + one catalog and
# can span multiple projects (a standalone project is a group of one). api.auth is
# the centralized, product-agnostic source of truth for the catalog (plans/packages
# stored with opaque features JSON it never interprets). Groups, their encrypted
# Stripe credentials, and the catalog are managed via /admin/billing (dashboard) or
# scripts/migrations/billing_group_bootstrap.py; consumers read the catalog via
# GET /internal/projects/{project_hash}/billing/catalog.
#
# Enable each switch only after additive billing schema, redaction, raw-body
# webhook verification, S2S bearer checks, retention, and runbook gates pass.
BILLING_ENABLED=false
BILLING_S2S_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_PORTAL_ENABLED=false
BILLING_SYNC_ENABLED=false

# Comma-separated http(s) origins that Checkout/Portal return URLs may point at.
# REQUIRED as soon as BILLING_CHECKOUT_ENABLED or BILLING_PORTAL_ENABLED is true:
# while it is empty readiness reports it missing and every Checkout/Portal request
# is refused with 503 (an empty allowlist allows no return URL).
# BILLING_ALLOWED_RETURN_ORIGINS is accepted as a fallback alias when this is empty.
BILLING_RETURN_URL_ALLOWLIST=

# Dedicated billing S2S credential and provider-ref cryptographic material.
# Generate strong unique values outside tests. BILLING_PROVIDER_REF_ENCRYPTION_KEY
# must be a Fernet-compatible URL-safe base64 32-byte key (same generation command as EMAIL_PAYLOAD_KEY above). Raw
# Stripe operational IDs must never be logged or returned; encrypted refs are
# only for server-side provider operations.
# BILLING_PROVIDER_REF_ENCRYPTION_KEY/_ID + BILLING_ID_HMAC_SECRET also encrypt the
# per-group Stripe account credentials (secret key + webhook secret) and the catalog
# product/price refs — they are REQUIRED to set group credentials or provision a
# catalog item to Stripe. Rotate by adding the old key id to
# BILLING_PROVIDER_REF_DECRYPTION_KEYS_JSON while promoting the new active key.
BILLING_S2S_BEARER_TOKEN=
BILLING_ID_HMAC_SECRET=
BILLING_PROVIDER_REF_ENCRYPTION_KEY=
BILLING_PROVIDER_REF_ENCRYPTION_KEY_ID=
BILLING_PROVIDER_REF_DECRYPTION_KEYS_JSON={}

# Billing retention and S2S abuse controls. Webhook delivery evidence is bounded
# and the (unused) raw payload quarantine table is capped, while normalized
# billing/purchase history remains durable for reconciliation.
BILLING_WEBHOOK_DELIVERY_RETENTION_DAYS=90
BILLING_RAW_PAYLOAD_RETENTION_DAYS=30
# Cadence at which the long-running billing sync worker runs the retention purge.
# 0 disables in-worker purging (run the purge one-shot mode or a cron instead).
BILLING_RETENTION_PURGE_INTERVAL_SECONDS=3600
BILLING_S2S_RATE_LIMIT=120
BILLING_S2S_RATE_WINDOW_SECONDS=60
# Per-route billing rate-limit buckets, enforced by src.Util.stripe.rate_limit
# alongside the S2S bucket above.
BILLING_CHECKOUT_RATE_LIMIT=30
BILLING_CHECKOUT_RATE_WINDOW_SECONDS=60
BILLING_PORTAL_RATE_LIMIT=30
BILLING_PORTAL_RATE_WINDOW_SECONDS=60
BILLING_RESYNC_RATE_LIMIT=30
BILLING_RESYNC_RATE_WINDOW_SECONDS=300

# Stripe provider adapter. These flags + the API-version pin are GLOBAL kill switches
# (effective_enabled = global provider/config flag AND per-group flag AND group
# credential_status='active'). Per LOCKED DECISION: each billing group has its OWN
# standalone Stripe account under one Stripe Organization; that account's secret key
# and webhook signing secret are stored ENCRYPTED in the DB per group (set via
# PUT /admin/billing/{group_hash}/credentials or the seed script) — NOT here.
# Each account uses POST /webhooks/stripe/{billing_group_hash} and its stored
# webhook secret. Readiness is computed per billing group; set each group's portal
# configuration through PUT /admin/billing/{group_hash}/credentials.
STRIPE_API_VERSION=2026-05-27.dahlia
# Event types the webhook processes; any other signed event is acknowledged as
# ignored_noop without writing. May list a subset of the nine supported types (to
# pause one, e.g. while investigating); a type outside them makes config loading fail.
STRIPE_ALLOWED_WEBHOOK_EVENTS=checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed,charge.refunded,charge.dispute.created,charge.dispute.closed
STRIPE_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_SIGNATURE_FAILURE_RATE_LIMIT=30
STRIPE_WEBHOOK_SIGNATURE_FAILURE_RATE_WINDOW_SECONDS=60

# Optional Stripe tests. Live/sandbox smoke must be explicit and isolated; never
# commit live provider credentials or webhook secrets here.
RUN_STRIPE_E2E=false
# The two hashes are required once RUN_STRIPE_E2E is true (the live smoke fails
# fast without them). The lookup key is optional: the test falls back to
# "stripe_live_smoke_lookup_key", so leave it commented out unless you override it.
STRIPE_LIVE_TEST_USER_HASH=
STRIPE_LIVE_TEST_PROJECT_HASH=
# STRIPE_LIVE_TEST_LOOKUP_KEY=

# Seed inputs for scripts/migrations/billing_group_bootstrap.py (operator-only; the
# script is dry-run by default and never prints secrets). PROJECT_HASH is the project
# to attach (BILLING_PROJECT_HASH is accepted as an alias and wins when both are set);
# SETUP_STRIPE_SECRET_KEY/SETUP_STRIPE_WEBHOOK_SECRET in the apply env are
# encrypted into the group's credentials. BILLING_GROUP_SEED_JSON/_FILE optionally
# override the default plus/pro/payg catalog.
# PROJECT_HASH=
# BILLING_GROUP_NAME=Magic Worlds
# BILLING_GROUP_SEED_JSON=
# BILLING_GROUP_SEED_FILE=
# --- End provider-agnostic billing with Stripe ---

# Root-only Deep Agents assistant (disabled until enabled in root dashboard settings).
# Uses the existing DB_HOST/DB_NAME database; deploy schemas/tables/14_assistant.sql.
# No separate database directory or local persistence is used.
# Generate a Fernet key securely before saving provider API keys. Never use an example key.
ASSISTANT_SECRET_KEY=
# Additional explicitly trusted provider hosts, e.g. host.docker.internal,ollama.internal
ASSISTANT_PROVIDER_HOSTS=
ASSISTANT_RUN_TIMEOUT_SECONDS=1800

# Optional billing-group bootstrap credential inputs.
SETUP_STRIPE_SECRET_KEY=
SETUP_STRIPE_WEBHOOK_SECRET=
SETUP_STRIPE_PORTAL_CONFIGURATION_ID=
